#!/usr/bin/env python3
"""Send one prompt from a worklog note to a herdr session.

Usage: worklog-send <obsidian-vault-dir> <YYYY-MM-DD> <item-id>

Run by the Obsidian Shell commands plugin when a ▶ button is clicked. The button's
URI carries only a date and an id, and any web page can open such a URI, so the
prompt text is never taken from the URI: it is read from the note's
```herdr-prompt id=<item-id> to=<workspace>``` block.
"""
import datetime
import json
import pathlib
import subprocess
import sys
import textwrap

SENDABLE = {"idle", "done", "working"}  # blocked = an approval/question UI: typing there could answer it


def fail(msg):
    print(f"worklog-send: {msg}", file=sys.stderr)
    sys.exit(1)


def unquote(line):
    """Strip list indentation and callout `>` markers, so a block folded in a callout reads plainly."""
    s = line.lstrip()
    if not s.startswith(">"):
        return line  # an unquoted block keeps its indentation; dedent() handles it
    while s.startswith(">"):
        s = s[1:]
        s = s[1:] if s.startswith(" ") else s
    return s


def find_block(note, item):
    """Return (to, text) of the herdr-prompt block with this id, scanning fence lines."""
    lines, i = [unquote(l) for l in note.splitlines()], 0
    while i < len(lines):
        words = lines[i].strip().split()
        if words and words[0] == "```herdr-prompt":
            attrs = dict(w.split("=", 1) for w in words[1:] if "=" in w)
            body, i = [], i + 1
            while i < len(lines) and lines[i].strip() != "```":
                body.append(lines[i])
                i += 1
            if attrs.get("id") == item:
                text = textwrap.dedent("\n".join(body)).strip()
                if not attrs.get("to") or not text:
                    fail(f"block {item!r} needs to= and a body")
                return attrs["to"], text
        i += 1
    fail(f"no herdr-prompt block with id={item!r}")


def herdr(*args):
    out = subprocess.run(["herdr", *args], capture_output=True, text=True)
    if out.returncode:
        fail(f"herdr {' '.join(args[:2])}: {out.stderr.strip() or out.stdout.strip()}")
    return out.stdout


def resolve(label):
    """Map a workspace label (one session per project) to the one agent pane in it."""
    spaces = json.loads(herdr("workspace", "list"))["result"]["workspaces"]
    ids = {w["workspace_id"] for w in spaces if w["label"] == label}
    if len(ids) != 1:
        fail(f"{len(ids)} herdr workspaces labelled {label!r}")
    agents = [a for a in json.loads(herdr("agent", "list"))["result"]["agents"] if a["workspace_id"] in ids]
    if len(agents) != 1:
        fail(f"{len(agents)} agents in workspace {label!r}; expected one")
    return agents[0]


def main(argv):
    if len(argv) != 4:
        fail(__doc__.strip().splitlines()[2])
    vault, date, item = pathlib.Path(argv[1]), argv[2], argv[3]
    try:
        datetime.date.fromisoformat(date)
    except ValueError:
        fail(f"not a date: {date!r}")
    if not item or not all(c.islower() or c.isdigit() or c == "-" for c in item):
        fail(f"not an item id: {item!r}")
    note = vault / f"{date}.md"
    if not note.is_file():
        fail(f"no note {note}")
    to, text = find_block(note.read_text(), item)
    agent = resolve(to)
    if agent["agent_status"] not in SENDABLE:
        fail(f"{to} agent is {agent['agent_status']}; answer it first")
    text += (f"\n\nWhen this is done, update the worklog with the worklog skill: work item "
             f"^{item} in {note}. Record the outcome and refresh Next.")
    herdr("agent", "prompt", agent["pane_id"], text)
    print(f"sent {item} to {to} ({agent['pane_id']})")


if __name__ == "__main__":
    main(sys.argv)
